{$DOMAIN} {
	encode gzip zstd

	# ── API ───────────────────────────────────────────────────────────────────
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	# ── Canlı bağlantı (Socket.IO) ────────────────────────────────────────────
	# WebSocket yükseltmesi Caddy'de otomatik; ayrı yapılandırma gerekmiyor.
	handle /realtime* {
		reverse_proxy api:3000
	}

	# ── Dosya ekleri ──────────────────────────────────────────────────────────
	# İmzalı adresler tarayıcıya gittiği için depolama dışarıdan erişilebilir
	# olmalı. Bucket public değil; erişim yalnızca kısa ömürlü imzalı adreslerle.
	#
	# Yol bucket adıyla birebir aynı olmalı ve KESİLMEMELİ: S3 imzası istek
	# yolunu da kapsıyor, `strip_prefix` ile önek soyulduğunda MinIO'nun gördüğü
	# yol imzalanandan farklı oluyor ve her yükleme 403 dönüyordu.
	handle /{$S3_BUCKET}/* {
		reverse_proxy minio:9000
	}

	# ── Masaüstü uygulama güncellemeleri ──────────────────────────────────────
	# electron-updater buradaki latest.yml / latest-mac.yml dosyalarını okur.
	handle /updates/* {
		root * /srv
		file_server browse
	}

	# ── Web paneli ────────────────────────────────────────────────────────────
	handle {
		reverse_proxy web:80
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
