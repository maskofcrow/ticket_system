:80 {
	root * /srv
	encode gzip zstd

	# SPA yönlendirmesi: /tickets/abc gibi istemci tarafı yolları index.html'e düşer.
	try_files {path} /index.html
	file_server

	# Hash'li varlıklar kalıcı önbelleğe alınabilir; index.html asla.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
