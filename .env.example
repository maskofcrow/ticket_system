# ── Veritabanı ───────────────────────────────────────────────────────────────
POSTGRES_USER=ticket
POSTGRES_PASSWORD=degistir-beni
POSTGRES_DB=ticket_system
# Yerelde başka bir PostgreSQL 5432'yi kullanıyor olabilir diye 5433 yayınlanıyor.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ticket:degistir-beni@localhost:5433/ticket_system

# ── Kimlik doğrulama ─────────────────────────────────────────────────────────
# Üretimde mutlaka değiştirin: openssl rand -base64 48
JWT_SECRET=gelistirme-ortami-icin-en-az-32-karakterlik-gizli-anahtar
# Lisans anahtarı lookup hash'i için HMAC pepper. DEĞİŞTİRİLİRSE mevcut tüm
# lisans anahtarları doğrulanamaz hale gelir — bir kez üretip saklayın.
LICENSE_PEPPER=gelistirme-ortami-icin-en-az-32-karakterlik-pepper-degeri
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Dosya depolama (MinIO / S3 uyumlu) ───────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ticket-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MAX_UPLOAD_MB=25

# ── E-posta (giden bildirim) ─────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="IT Destek <destek@firma.com>"

# ── Uygulama ─────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
# Web panelin adresi — e-posta bildirimlerindeki linkler bunu kullanır
PUBLIC_WEB_URL=http://localhost:5173
# 5173 web paneli, 5174 masaüstü uygulamanın geliştirme sunucusu.
# Paketlenmiş Electron uygulaması Origin başlığı göndermez, listeye eklenmesi gerekmez.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Seed (ilk yönetici hesabı) ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@firma.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NAME=Sistem Yöneticisi
